{
  "name": "vapi-concurrency-gateway",
  "version": "1.0.0",
  "description": "Per-tenant concurrent call caps for anyone reselling Vapi.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql && npm --prefix ui ci --no-audit --no-fund && npm --prefix ui run build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "license": "MIT"
}
